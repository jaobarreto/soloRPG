            "description": "Somente psychic-shield: erguer=true ou baixar=false, se declarado. Nos demais arcanos omitir ou null."
          },
          "tradition": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["PSYCHIC", "ANIMISM", "HEALING", "MEDITATIVE"]
