              },
              {
                "type": "null"
              }
            ],
            "title": "Use",
            "description": "Somente body-control: uso expressamente escolhido. Nos demais arcanos omitir ou null."
          },
          "fatigue": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fatigue",
            "description": "Somente move-object: opção voluntária expressamente escolhida. Não é fadiga calculada pelo motor. Nos demais omitir ou null."
          },
          "category": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 0.0
              },
              {
                "type": "null"
