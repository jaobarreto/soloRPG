            "title": "Tradition",
            "description": "Somente psychic-contact ou body-control, se declarada. Não deduzir tradição pelo nome do arcano ou pela ficha. Nos demais omitir ou null."
          },
          "use": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SLEEP",
                  "DIFFICULT_SLEEP",
                  "HALF_BREATHING",
                  "QUARTER_BREATHING",
                  "IGNORE_PAIN",
                  "BODY_AWARENESS",
                  "FEIGN_DEATH"
