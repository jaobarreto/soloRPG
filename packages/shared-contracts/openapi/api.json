  "info": {
    "title": "SoloRPG API",
    "description": "Campaigns, sessions and persistent chat",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["solo-rpg-api", "solo-rpg-ai", "postgresql"]
          }
        },
        "required": ["status", "service"]
      },
      "CreateCampaignDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000
          },
          "plannedSessions": {
            "type": "number",
            "default": 8,
            "minimum": 1,
            "maximum": 1000
          },
          "defaultSessionDurationMinutes": {
            "type": "number",
            "default": 120,
            "minimum": 1,
            "maximum": 10080
          }
        },
        "required": ["title"]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "campaignId": {
            "type": "string"
          },
          "sessionNumber": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "LOCKED",
              "AVAILABLE",
              "IN_PROGRESS",
              "PAUSED",
              "COMPLETED"
            ]
          },
          "estimatedDurationMinutes": {
            "type": "number"
          },
          "activeDurationSeconds": {
            "type": "number"
          },
          "timeMeasuredAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "resumedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "pausedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "endingType": {
            "type": "string",
            "nullable": true,
            "enum": [
              "OBJECTIVE_COMPLETED",
              "NARRATIVE_PAUSE",
              "PLAYER_REQUESTED"
            ]
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "campaignId",
          "sessionNumber",
          "title",
          "description",
          "status",
          "estimatedDurationMinutes",
          "activeDurationSeconds",
          "timeMeasuredAt",
          "startedAt",
          "resumedAt",
          "pausedAt",
          "completedAt",
          "endingType",
          "summary",
          "createdAt",
          "updatedAt"
        ]
      },
      "CampaignDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "plannedSessions": {
            "type": "number"
          },
          "defaultSessionDurationMinutes": {
            "type": "number"
          },
          "currentSessionNumber": {
            "type": "number",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "ACTIVE", "COMPLETED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionResponseDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "plannedSessions",
          "defaultSessionDurationMinutes",
          "currentSessionNumber",
          "status",
          "createdAt",
          "updatedAt",
          "completedAt",
          "sessions"
        ]
      },
      "CampaignResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "plannedSessions": {
            "type": "number"
          },
          "defaultSessionDurationMinutes": {
            "type": "number"
          },
          "currentSessionNumber": {
            "type": "number",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "ACTIVE", "COMPLETED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "plannedSessions",
          "defaultSessionDurationMinutes",
          "currentSessionNumber",
          "status",
          "createdAt",
          "updatedAt",
          "completedAt"
        ]
      },
      "UpdateCampaignDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000
          }
        }
      },
      "CompleteSessionDto": {
        "type": "object",
        "properties": {
          "endingType": {
            "type": "string",
            "enum": [
              "OBJECTIVE_COMPLETED",
              "NARRATIVE_PAUSE",
              "PLAYER_REQUESTED"
            ]
          }
        },
        "required": ["endingType"]
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {
          "interactionMode": {
            "type": "string",
            "enum": ["SPEAK", "ACT", "THINK", "OUT_OF_CHARACTER"]
          },
          "content": {
            "type": "string",
            "description": "Nonblank text, limited by MESSAGE_MAX_LENGTH (default 10000)."
          }
        },
        "required": ["interactionMode", "content"]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "campaignId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["PLAYER", "GAME_MASTER", "SYSTEM"]
          },
          "interactionMode": {
            "type": "string",
            "nullable": true,
            "enum": ["SPEAK", "ACT", "THINK", "OUT_OF_CHARACTER"]
          },
          "content": {
            "type": "string"
          },
          "sequenceNumber": {
            "type": "number"
          },
          "metadata": {
            "type": "object",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "campaignId",
          "sessionId",
          "role",
          "interactionMode",
          "content",
          "sequenceNumber",
          "metadata",
          "createdAt"
        ]
      },
      "MessagePageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageResponseDto"
            }
          },
          "nextCursor": {
            "type": "number",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": ["data", "nextCursor", "hasMore"]
      }
    }
  }
}
