# Copie com pnpm setup:env para gerar senha aleatória local (não versionada).
NODE_ENV=development
POSTGRES_USER=solorpg
POSTGRES_PASSWORD=
POSTGRES_DB=solorpg
POSTGRES_PORT=5432
# Para execução no host: URL com senha codificada (percent-encoding se necessário).
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3001
AI_SERVICE_PORT=8000
WEB_PORT=3000
AI_SERVICE_URL=http://127.0.0.1:8000
# Usada somente pelo servidor Next; no Compose muda para http://api:3001.
API_INTERNAL_URL=http://127.0.0.1:3001
# URL pública relativa: funciona também quando o navegador está em outro computador.
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HEALTH_TIMEOUT_MS=3000
# Limite validado pela API para cada mensagem da jogadora.
MESSAGE_MAX_LENGTH=10000
# Gere um segredo local para autenticar NestJS → FastAPI (pnpm setup:env gera em instalações novas).
AI_INTERNAL_TOKEN=
# Confirme somente para contas/projetos SEM faturamento habilitado.
# Dados da cena e mensagens deixam a máquina ao consultar o provedor externo.
AI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=gemini
ENABLE_PROVIDER_FALLBACK=false
LLM_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
